diff --git a/doomgeneric/m_fixed.c b/doomgeneric/m_fixed.c
index 23f6ff3..c779169 100644
--- a/doomgeneric/m_fixed.c
+++ b/doomgeneric/m_fixed.c
@@ -24,12 +24,28 @@
 #include "i_system.h"
 
 #include "m_fixed.h"
+#include <math.h>
 
 
 
 
 // Fixme. __USE_C_FIXED__ or something.
 
+#ifdef LENS
+// LENS: no 64-bit math. wasm2js emulates i64 in software, which made these
+// two functions the hottest code in the renderer. Both are bit-exact with
+// the originals (verified by engine/lens/test_fixed.c).
+fixed_t FixedMul(fixed_t a, fixed_t b)
+{
+    int32_t ah = a >> 16, bh = b >> 16;
+    uint32_t al = (uint32_t)a & 0xffff, bl = (uint32_t)b & 0xffff;
+    uint32_t r = ((uint32_t)(ah * bh) << 16)
+               + (uint32_t)(ah * (int32_t)bl)
+               + (uint32_t)((int32_t)al * bh)
+               + ((al * bl) >> 16);
+    return (fixed_t)r;
+}
+#else
 fixed_t
 FixedMul
 ( fixed_t	a,
@@ -37,6 +53,7 @@ FixedMul
 {
     return ((int64_t) a * (int64_t) b) >> FRACBITS;
 }
+#endif
 
 
 
@@ -52,11 +69,25 @@ fixed_t FixedDiv(fixed_t a, fixed_t b)
     }
     else
     {
+#ifdef LENS
+	// trunc(a*65536/b) in doubles; a*65536 < 2^47 and q*b are exact, so one
+	// remainder check corrects the at-most-1 rounding error of the division.
+	double x = (double)a * 65536.0, y = (double)b;
+	double q = trunc(x / y);
+	double r = x - q * y;
+	double dir = ((x < 0) != (y < 0)) ? -1.0 : 1.0;
+	if (r != 0 && ((r < 0) != (x < 0)))
+	    q -= dir;
+	else if (fabs(r) >= fabs(y))
+	    q += dir;
+	return (fixed_t)q;
+#else
 	int64_t result;
 
 	result = ((int64_t) a << 16) / b;
 
 	return (fixed_t) result;
+#endif
     }
 }
 
